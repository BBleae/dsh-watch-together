{
  "name": "dsh-watch-stack",
  "version": "0.1.0",
  "description": "Install the whole watch-together stack in one command: eyes, ears, mouth, browser, hands and the control panel.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "watch-together",
    "vision",
    "speech"
  ],
  "author": "Eli-Mao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eli-Mao/dsh-watch-together.git"
  },
  "homepage": "https://github.com/Eli-Mao/dsh-watch-together#readme",
  "bugs": {
    "url": "https://github.com/Eli-Mao/dsh-watch-together/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "os": [
    "win32"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "RELEASE.md",
    "install.ps1",
    "install.sh",
    "skills",
    "LICENSE",
    "AGENT-INSTALL.md"
  ],
  "dependencies": {
    "dsh-watch-eyes": "workspace:*",
    "dsh-watch-ears": "workspace:*",
    "dsh-watch-mouth": "workspace:*",
    "dsh-watch-browser": "workspace:*",
    "dsh-watch-hands": "workspace:*",
    "dsh-watch-panel": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --check lib/index.js"
  },
  "packageManager": "pnpm@11.28.5"
}
